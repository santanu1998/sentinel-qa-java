{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Authentication token response",
  "type": "object",
  "required": ["token"],
  "properties": {
    "token": {
      "type": "string",
      "minLength": 8,
      "description": "Opaque session token used as a cookie on mutating calls"
    }
  }
}
