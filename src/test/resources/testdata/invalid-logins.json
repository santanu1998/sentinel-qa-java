[
  {
    "case": "Both fields blank",
    "username": "",
    "password": "",
    "expectedMessage": "Username is required"
  },
  {
    "case": "Password blank",
    "username": "standard_user",
    "password": "",
    "expectedMessage": "Password is required"
  },
  {
    "case": "Unknown user",
    "username": "no_such_user",
    "password": "secret_sauce",
    "expectedMessage": "Username and password do not match"
  },
  {
    "case": "Correct user, wrong password",
    "username": "standard_user",
    "password": "wrong_password",
    "expectedMessage": "Username and password do not match"
  },
  {
    "case": "Case-sensitive username",
    "username": "STANDARD_USER",
    "password": "secret_sauce",
    "expectedMessage": "Username and password do not match"
  },
  {
    "case": "Leading and trailing whitespace",
    "username": "  standard_user  ",
    "password": "secret_sauce",
    "expectedMessage": "Username and password do not match"
  },
  {
    "case": "SQL injection attempt",
    "username": "' OR '1'='1",
    "password": "' OR '1'='1",
    "expectedMessage": "Username and password do not match"
  },
  {
    "case": "Script injection attempt",
    "username": "<script>alert(1)</script>",
    "password": "secret_sauce",
    "expectedMessage": "Username and password do not match"
  }
]
