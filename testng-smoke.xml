<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<!--
  Smoke suite: the build gate. Runs on every pull request and must finish in under five minutes.
  If anything here is red, nothing downstream is worth running.
-->
<suite name="SentinelQA-Smoke" parallel="methods" thread-count="4" verbose="1">

    <listeners>
        <listener class-name="com.sentinelqa.listeners.TestListener"/>
        <listener class-name="com.sentinelqa.listeners.RetryTransformer"/>
    </listeners>

    <parameter name="browser" value="chrome"/>

    <groups>
        <run>
            <include name="smoke"/>
            <exclude name="known-defects"/>
        </run>
    </groups>

    <test name="Smoke - API">
        <packages>
            <package name="com.sentinelqa.tests.api"/>
        </packages>
    </test>

    <test name="Smoke - UI">
        <packages>
            <package name="com.sentinelqa.tests.ui"/>
        </packages>
    </test>
</suite>
