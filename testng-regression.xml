<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<!--
  Full regression: nightly, and before every release candidate.
  Cross-browser UI, full API contract set, and the API-to-data-store integration layer.
-->
<suite name="SentinelQA-Regression" parallel="methods" thread-count="6" verbose="1">

    <listeners>
        <listener class-name="com.sentinelqa.listeners.TestListener"/>
        <listener class-name="com.sentinelqa.listeners.RetryTransformer"/>
    </listeners>

    <groups>
        <run>
            <include name="regression"/>
            <include name="integration"/>
            <exclude name="known-defects"/>
        </run>
    </groups>

    <test name="Regression - API contract">
        <parameter name="browser" value="chrome"/>
        <packages>
            <package name="com.sentinelqa.tests.api"/>
        </packages>
    </test>

    <test name="Regression - Integration and database">
        <parameter name="browser" value="chrome"/>
        <packages>
            <package name="com.sentinelqa.tests.integration"/>
        </packages>
    </test>

    <test name="Regression - UI on Chrome">
        <parameter name="browser" value="chrome"/>
        <packages>
            <package name="com.sentinelqa.tests.ui"/>
        </packages>
    </test>

    <test name="Regression - UI on Firefox">
        <parameter name="browser" value="firefox"/>
        <packages>
            <package name="com.sentinelqa.tests.ui"/>
        </packages>
    </test>

    <test name="Regression - UI on Edge">
        <parameter name="browser" value="edge"/>
        <packages>
            <package name="com.sentinelqa.tests.ui"/>
        </packages>
    </test>
</suite>
