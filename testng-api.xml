<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<!--
  API-only suite. No browser is started, so this runs in roughly 40 seconds and is the
  fastest useful signal after a backend deployment.
-->
<suite name="SentinelQA-API" parallel="methods" thread-count="8" verbose="1">

    <listeners>
        <listener class-name="com.sentinelqa.listeners.TestListener"/>
        <listener class-name="com.sentinelqa.listeners.RetryTransformer"/>
    </listeners>

    <groups>
        <run>
            <include name="api"/>
            <exclude name="known-defects"/>
        </run>
    </groups>

    <test name="API contract and CRUD">
        <packages>
            <package name="com.sentinelqa.tests.api"/>
        </packages>
    </test>
</suite>
